# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/cpm_portal

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
PASSWORD_RESET_EXPIRES_MIN=30

# Frontend
CLIENT_URL=http://localhost:5173
CLIENT_URL=https://frontend-swart-alpha-21.vercel.app/api

# File storage
STORAGE_DRIVER=local
UPLOAD_DIR=src/uploads
MAX_FILE_SIZE_MB=15

# Rate limiting
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# SMTP (optional - when empty, password reset links are printed to the server console)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CPM Portal <no-reply@example.com>

# Seed account (npm run seed)
SEED_ADMIN_EMAIL=admin@portal.test
SEED_ADMIN_PASSWORD=Admin@12345
