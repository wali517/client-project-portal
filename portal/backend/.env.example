NODE_ENV=production
PORT=5000
MONGO_URI=<your mongodb connection string>
JWT_SECRET=<long random string>
# Deployed FRONTEND url (reset-password links in emails point here, no trailing slash)
CLIENT_URL=https://frontend-theta-khaki-99.vercel.app

# --- Email (required in production so reset mails reach a real inbox) ---
# Gmail: enable 2-Step Verification, create an App Password, then:
SMTP_SERVICE=gmail
SMTP_USER=youraddress@gmail.com
SMTP_PASSWORD=<16-char app password>
SMTP_FROM="CPM Portal <youraddress@gmail.com>"
# Other providers: leave SMTP_SERVICE empty and set SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASSWORD
PASSWORD_RESET_EXPIRES_MIN=30
