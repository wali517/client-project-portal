# ===== LOCAL TESTING: put these lines in backend/.env =====
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/cpm_portal_dev
JWT_SECRET=any-long-random-text-for-local-only
CLIENT_URL=http://localhost:5173

# Email (optional while testing locally)
SMTP_SERVICE=gmail
SMTP_USER=youraddress@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=CPM Portal <youraddress@gmail.com>
PASSWORD_RESET_EXPIRES_MIN=30

# ===== LIVE (Vercel backend project > Settings > Environment Variables) =====
# NODE_ENV=production
# MONGO_URI=your live MongoDB connection string (database cpm_portal)
# JWT_SECRET=a different long random text
# CLIENT_URL=https://your-live-frontend.vercel.app   (no slash, no /api)
# SMTP_SERVICE, SMTP_USER, SMTP_PASSWORD, SMTP_FROM as above
