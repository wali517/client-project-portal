# ===== LIVE (set these in Vercel -> backend project -> Settings -> Environment Variables) =====
NODE_ENV=production
MONGO_URI=<your live MongoDB connection string (db cpm_portal)>
JWT_SECRET=<long random string, keep the one already used live so users stay logged in>
CLIENT_URL=https://frontend-swart-alpha-21.vercel.app
SMTP_SERVICE=gmail
SMTP_USER=youraddress@gmail.com
SMTP_PASSWORD=<16-char Gmail App Password>
SMTP_FROM=CPM Portal <youraddress@gmail.com>
PASSWORD_RESET_EXPIRES_MIN=30
